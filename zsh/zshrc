HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000

# Append history instead of overwriting
setopt APPEND_HISTORY

# Write to history immediately, not when shell exits
setopt INC_APPEND_HISTORY

# Share history across all sessions
setopt SHARE_HISTORY

# Don't store duplicate entries
setopt HIST_IGNORE_DUPS

# Remove older duplicate entries from history
setopt HIST_IGNORE_ALL_DUPS

# Don't record commands that start with a space
setopt HIST_IGNORE_SPACE

# Remove unnecessary blanks from commands
setopt HIST_REDUCE_BLANKS

# When searching history, don't show duplicates
setopt HIST_FIND_NO_DUPS

# Keep timestamps and prefer preserving unique, recent commands.
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_SAVE_NO_DUPS


# Disable flow control commands (keeps C-s from freezing everything)
# Must check if stdin is a terminal to avoid errors
if [[ -t 0 ]]; then
  stty start undef 2>/dev/null
  stty stop undef 2>/dev/null
fi

if [[ -z "$LC_ALL" ]]; then
  export LC_ALL='en_US.UTF-8'
fi

autoload -Uz compinit
compinit

# Added by OrbStack: command-line tools and integration
# This won't be added again if you remove it.
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# Loading themes before use it
autoload promptinit
fpath=($HOME/.zsh.prompts $fpath)
promptinit

# Source Prezto.
# if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
#   source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
# fi

source $HOME/.dotfiles/scripts/utils.sh
# source $HOME/.dotfiles/scripts/tmux.sh

# Customize to your needs...
for config_file (~/.dotfiles/zsh/*.zsh) source $config_file

setopt RM_STAR_WAIT
setopt CORRECT

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Use Atuin for an improved Ctrl-R search experience when available.
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

# pnpm
export PNPM_HOME="/Users/vinicius/Library/pnpm"
export PYTHON_HOME="$(brew --prefix)/opt/python@3.9/libexec/bin"
export PATH="$PYTHON_HOME:$PNPM_HOME:$PATH"
# pnpm endexport PATH="/usr/local/opt/libpq/bin:$PATH"

# source /Users/vinicius/.docker/init-zsh.sh || true # Added by Docker Desktop

# Suppress output from defaults write
defaults write -g AppleFontSmoothing -int 0 &>/dev/null

# bun completions
[ -s "/Users/vinicius/.bun/_bun" ] && source "/Users/vinicius/.bun/_bun"

# Source zsh-autosuggestions
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# # Source staship
# eval "$(starship init zsh)"

# Source powerlevel10k theme
source $(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# fastfetch --config ~/.dotfiles/fastfetch/minimal.jsonc


# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
